# Fill in and hand to setup-server.sh (it writes deploy/.env and host.env from
# it). Values must not carry inline `# comments`.

DOMAIN=owlgraph.example.com
GITHUB_OWNER=gemane

# The product version to run — the git tag on main, without the leading v.
# The same version's web tarball must be unpacked into WEB_DIR.
APP_VERSION=1.0.0
WEB_DIR=/srv/owlgraph/www

# ArcadeDB. 26.10.1 or later: 26.7.3 returns INCOMPLETE index range reads on
# big indexes (fixed by ArcadeDB PR #7616). Check the upstream bug tracker
# before any version change.
ARCADEDB_VERSION=26.10.1
ARCADEDB_DATA=/srv/owlgraph/arcadedb
ARCADEDB_DATABASE=owlgraph
ARCADEDB_ROOT_PASSWORD=change-me-Upper1!
ARCADEDB_HEAP=8g

# The files the importers read, and their scratch space (mounted at /data).
DATA_DIR=/srv/owlgraph/data

CADDY_VERSION=2.10

# ── the backend's own settings (see backend/README.md) ──
SECRET_KEY=
CORS_ORIGINS=https://owlgraph.example.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
EMAIL_BACKEND=
SCRAPER_ENABLED=true
SCRAPER_SEC_EDGAR_ENABLED=true
# What `owlgraph alerts` checks (docs/operations.md, Monitoring). The backup
# marker is written by `owlgraph backup` into DATA_DIR, seen at /data here.
ALERT_BACKUP_MARKER=/data/backup.last
ALERT_DISK_PATHS=/data

# ── host only: setup-server.sh keeps these out of every container ──
# The first data load: full (the whole golden copy, many hours), test (the
# curated subset, minutes) or none.
IMPORT=full
# Cap the UK PSC load (empty = the whole register).
PSC_LIMIT=
# Backups: how many archives to keep, and an rsync target off this box.
BACKUP_KEEP=7
BACKUP_REMOTE=
# Only for a private image: a token with read:packages.
GHCR_USER=
GHCR_TOKEN=
# Dead man's switch per cron job (Healthchecks.io ping URLs), all optional.
HC_BACKUP=
HC_GLEIF_UPDATE=
HC_WEEKLY_REPORT=
HC_PRUNE_ANALYTICS=
