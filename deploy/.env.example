# Copy to deploy/.env and fill in. Values must not carry inline `# comments`.

DOMAIN=owlgraph.example.com
GITHUB_OWNER=gemane

# The product version to run — the git tag on main, without the leading v.
# The same version's web tarball must be unpacked into WEB_DIR.
APP_VERSION=1.0.0
WEB_DIR=/srv/owlgraph/www

# ArcadeDB. 26.10.1 or later: 26.7.3 returns INCOMPLETE index range reads on
# big indexes (fixed by ArcadeDB PR #7616). Check the upstream bug tracker
# before any version change.
ARCADEDB_VERSION=26.10.1
ARCADEDB_DATA=/srv/owlgraph/arcadedb
ARCADEDB_DATABASE=owlgraph
ARCADEDB_ROOT_PASSWORD=change-me-Upper1!
ARCADEDB_HEAP=8g

CADDY_VERSION=2.10

# ── the backend's own settings (see backend/README.md) ──
SECRET_KEY=
CORS_ORIGINS=https://owlgraph.example.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
EMAIL_BACKEND=
SCRAPER_ENABLED=true
SCRAPER_SEC_EDGAR_ENABLED=true
