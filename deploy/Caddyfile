# Owlgraph production — TLS, the web app, and the API behind one origin.
# The web app is built with PROD_API_URL = https://{$DOMAIN}, so the browser
# talks to the same origin and Caddy routes by path: the API's paths go to
# uvicorn, everything else is the static app (a client-side router, so unknown
# paths fall back to index.html).

{$DOMAIN} {
	encode zstd gzip

	@api path /v1/* /health /app-version /docs /redoc /openapi.json
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# The container healthcheck's own door: plain HTTP on 8080, never published
# (only Caddy's 80/443 are), so it cannot be reached from outside. The public
# site cannot serve the check — HTTP redirects to HTTPS and there is no
# certificate for "localhost", so the check failed forever. This proves Caddy
# runs and routes to the API; TLS is checked from outside (setup-server.sh,
# the uptime check).
:8080 {
	reverse_proxy /health api:8000
}
