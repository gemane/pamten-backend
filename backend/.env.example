ARCADEDB_URL=http://<your-instance>:2480
ARCADEDB_USERNAME=root
ARCADEDB_PASSWORD=<password>
ARCADEDB_DATABASE=owlgraph

# Must be at least 32 chars — the app refuses to start with a shorter key in
# any mode, and additionally refuses the insecure default when DEBUG=False.
# Generate with: openssl rand -hex 32
SECRET_KEY=<long-random-string>

# Comma-separated list of allowed frontend origins for CORS (no wildcard
# is used since requests are authenticated with credentials).
CORS_ORIGINS=https://pamten-frontend.onrender.com,http://localhost:5173

# Transactional email (verification + password reset). Empty EMAIL_BACKEND =
# console backend (links are logged, nothing is sent) — fine for dev.
#   EMAIL_BACKEND = console | smtp | resend | scaleway
# SCALEWAY (HTTPS API, works from Render which blocks SMTP): set
# EMAIL_BACKEND=scaleway, SCALEWAY_SECRET_KEY (the API key's Secret Key),
# SCALEWAY_PROJECT_ID (the sending domain's project), SCALEWAY_TEM_REGION
# (fr-par | nl-ams | pl-waw), and EMAIL_FROM on a domain verified in Scaleway
# TEM with SPF/DKIM/DMARC (e.g. noreply@owlgraph.org).
# RESEND (also an HTTPS API): set EMAIL_BACKEND=resend, RESEND_API_KEY, and
# EMAIL_FROM to a Resend-verified sender (verify your domain, e.g.
# noreply@owlgraph.org; or onboarding@resend.dev in test mode, which only
# delivers to the account owner).
# GMAIL/SMTP (works locally, NOT from Render): EMAIL_BACKEND=smtp + SMTP_HOST=
# smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME/SMTP_PASSWORD (a Google App
# Password), EMAIL_FROM=Owlgraph <you@gmail.com>.
EMAIL_BACKEND=
RESEND_API_KEY=
SCALEWAY_SECRET_KEY=
SCALEWAY_PROJECT_ID=
SCALEWAY_TEM_REGION=fr-par
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# Frontend origin used to build the links inside verification / reset emails.
APP_BASE_URL=http://localhost:5173
# Require a verified email before login (verify/reset links expire per the TTLs).
REQUIRE_EMAIL_VERIFICATION=true

DEBUG=True

# Master scraper switch — must be true for any scraper to run
# Usage measurement: aggregate counts of what is searched for and which features
# are used. No user id, session, IP or timestamp is stored (app/analytics.py).
# Leave off until the privacy notice and the app-store declarations describe it.
ANALYTICS_ENABLED=false

SCRAPER_ENABLED=false

# Individual scraper switches (master switch must also be true)
SCRAPER_WIKIDATA_ENABLED=false
SCRAPER_SEC_EDGAR_ENABLED=false
SCRAPER_OPENCORPORATES_ENABLED=false
# Bulk ownership datasets (large files – run from the CLI in a tmux session)
SCRAPER_BODS_GLEIF_ENABLED=false    # GLEIF golden copy: gleif-lei-cdf / gleif-rr / gleif-succession
SCRAPER_BODS_UK_PSC_ENABLED=false   # Companies House: ch-psc / ch-company-data

# Optional API keys (leave empty to use free tier)
OPENCORPORATES_API_KEY=

# Geocoding (Nominatim / OpenStreetMap). Turn on to geocode addresses to
# coordinates. Set a contact email — the public Nominatim endpoint's usage
# policy requires a descriptive User-Agent, and enforces ~1 request/second.
GEOCODING_ENABLED=false
GEOCODING_CONTACT=
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# GEOCODING_MIN_INTERVAL=1.0
