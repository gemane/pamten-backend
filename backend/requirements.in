# Runtime dependencies of the API and the importers — the INPUT to the lock.
#
#   requirements.in      what the app needs, with each licence (MIT/Apache/BSD-class only,
#                        see the project constraints) — edit THIS file
#   requirements.txt     the lock: every package, direct and indirect, pinned exactly.
#                        Generated, never edited by hand:
#                          pip-compile --strip-extras requirements.in
#                        (pip-tools, run with the same Python as CI and the image: 3.13)
#
# The dev tools (tests, lint) are in requirements-dev.in, so they do not ship in the
# production image. Licences are documented HERE (the lock is generated), and
# tests/test_dependency_licences.py checks every locked package — indirect ones
# included — against the allowed list on each run.
fastapi              # MIT
uvicorn              # BSD-3-Clause
pydantic             # MIT
pydantic-settings    # MIT
email-validator      # Unlicense (public domain) — validates signup emails
python-dotenv        # BSD-3-Clause
httpx                # BSD-3-Clause
boto3                # Apache-2.0 — S3-compatible object store (app/objectstore.py)
PyJWT                # MIT
bcrypt               # Apache-2.0 — password hashing, used directly (passlib dropped: unmaintained, breaks with modern bcrypt)
beautifulsoup4       # MIT
lxml                 # BSD-3-Clause
ijson                # BSD-3-Clause
orjson               # MPL-2.0 AND (Apache-2.0 OR MIT) since 3.11 (was Apache-2.0 OR MIT) — MPL 2.0 is on the allowed list; fast NDJSON parsing for the bulk importers
cryptography         # Apache-2.0 OR BSD-3-Clause — Ed25519 federation signing
